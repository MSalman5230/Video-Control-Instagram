{
  "manifest_version": 3,
  "name": "Instagram Native Video Controls",
  "version": "2.0.0",
  "description": "Shows Chrome's native HTML5 video controls on Instagram videos when you hover them.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
